# Copy this file to .env.local for local development and fill in YOUR values.
# On Vercel add the same variables under Project Settings -> Environment Variables.
# Never commit .env.local and never paste these values into chats.

# Supabase dashboard -> Project Settings -> API. Copy the URL exactly, do not retype it.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. The service role (or "secret") key. It bypasses all security rules.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Domain used for generated school emails (firstname.surname@this-domain)
SCHOOL_EMAIL_DOMAIN=jaligos.co.za
